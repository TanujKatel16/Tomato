PORT=5000
CLIENT_URL=http://localhost:3000

# Prisma CLI connection URL. Keep these values in sync with DB_* below.
DATABASE_URL=mysql://YOUR_DB_USER:YOUR_URL_ENCODED_PASSWORD@localhost:3306/tomato

# Runtime Prisma MariaDB adapter connection.
DB_HOST=localhost
DB_PORT=3306
DB_USER=YOUR_DB_USER
DB_PASSWORD=YOUR_PASSWORD
DB_NAME=tomato
